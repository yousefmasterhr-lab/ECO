# ==============================================================================
# ECO ERP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (local) and configure secrets in Cloudflare Pages
# NEVER commit real secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication & Security (REQUIRED in BOTH Cloudflare Pages & sqlBridge.cjs)
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be identical across Cloudflare Pages Environment Variables and local .env
JWT_SECRET=<REPLACE_WITH_64_HEX_JWT_SECRET>

# Shared secret required alongside Admin JWT for /api/system/query & /api/system/config
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_SHARED_SECRET=<REPLACE_WITH_64_HEX_BRIDGE_SECRET>

# Strict comma-separated CORS origin allowlist (NO wildcard '*' allowed)
# Example: https://eco.hrsup.com,https://app.hrsup.com
ALLOWED_ORIGINS=https://eco.hrsup.com

# Runtime Environment: production | development
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Frontend Connection Mode
# ------------------------------------------------------------------------------
# Database Connection Mode: LOCAL (SQL Server) | CLOUD (Mock/Sandbox)
VITE_DB_CONNECTION_MODE=LOCAL

# ------------------------------------------------------------------------------
# 3. Microsoft SQL Server Bridge Configuration (Local sqlBridge.cjs)
# ------------------------------------------------------------------------------
DB_SERVER=<YOUR_SQL_SERVER_HOST>
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=<REPLACE_WITH_SQL_SERVER_PASSWORD>
DB_NAME=Tarabot_Data_2026

# Server Port
PORT=5000
